# A+ Solution staging mobile environment
# Copy these values into GitHub Actions / local staging builds.

APP_ENV=staging
VITE_APP_NAME=A+ Solution Staging
VITE_API_BASE_URL=https://staging-api.example.com
VITE_FIREBASE_PROJECT_ID=replace-with-staging-project
VITE_FIREBASE_APP_ID=replace-with-staging-app-id

# Keep staging credentials separate from production.
# Never reuse production Firebase/API keys here.
