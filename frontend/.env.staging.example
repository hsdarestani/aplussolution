# A+ Solution staging mobile environment
# Non-secret defaults. Signing credentials and Firebase JSON stay in Publisher.

APP_ENV=staging
CAPACITOR_APP_ID=de.aplussolution.staging
CAPACITOR_APP_NAME=A+ Solution Staging
VITE_APP_ENV=staging
VITE_NATIVE_APP_ID=de.aplussolution.staging
VITE_API_URL=https://staging.app.aplus-solution.de/api

# Staging store builds are push-ready by default and fail closed if the native
# provider configuration is missing. Register de.aplussolution.staging as an
# Android app in Firebase and provide its google-services.json to Publisher.
REQUIRE_NATIVE_PUSH=1
GOOGLE_SERVICES_JSON_BASE64=<base64 staging google-services.json>
# Alternatively Publisher may provide the raw JSON through GOOGLE_SERVICES_JSON.
# GOOGLE_SERVICES_JSON=<raw staging google-services.json>

# iOS uses the staging bundle ID with a Push Notifications-enabled App ID and
# App Store distribution provisioning profile. APNs provider credentials are
# configured on the staging backend, not embedded in the mobile application.
IOS_BUNDLE_ID=de.aplussolution.staging
