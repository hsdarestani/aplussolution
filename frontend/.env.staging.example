# A+ Solution staging mobile environment
# These are non-secret defaults. Signing credentials and Firebase JSON stay in Publisher.

APP_ENV=staging
CAPACITOR_APP_ID=de.aplussolution.staging
CAPACITOR_APP_NAME=A+ Solution Staging
VITE_APP_ENV=staging
VITE_API_URL=https://staging.app.aplus-solution.de/api

# Optional until native push is enabled for the staging app:
# REQUIRE_NATIVE_PUSH=1
# GOOGLE_SERVICES_JSON_BASE64=<base64 staging google-services.json>
# GOOGLE_SERVICES_JSON=<raw staging google-services.json>
