# Core
DEBUG=1
DJANGO_SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,solution.smarbiz.sbs,5.75.205.93
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://solution.smarbiz.sbs
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://solution.smarbiz.sbs
APP_URL=https://solution.smarbiz.sbs
API_URL=https://solution.smarbiz.sbs/api
APP_DOMAIN=solution.smarbiz.sbs

# Database
POSTGRES_DB=aplussolution
POSTGRES_USER=aplussolution
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://aplussolution:change-this-database-password@db:5432/aplussolution
REDIS_URL=redis://redis:6379/0

# Initial admin
DJANGO_SUPERUSER_EMAIL=admin@aplus-solution.de
DJANGO_SUPERUSER_PASSWORD=change-this-admin-password
DJANGO_SUPERUSER_FIRST_NAME=A+
DJANGO_SUPERUSER_LAST_NAME=Admin

# E-mail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=A+ Solution <noreply@aplus-solution.de>
ADMIN_NOTIFICATION_EMAIL=info@aplus-solution.de

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://solution.smarbiz.sbs/api/auth/oauth/google/callback/

# Apple Sign In
APPLE_SERVICE_ID=de.aplussolution.workforce.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_OAUTH_REDIRECT_URI=https://solution.smarbiz.sbs/api/auth/oauth/apple/callback/

# SAML 2.0 / Enterprise SSO
SAML_ENABLED=0
SAML_SP_ENTITY_ID=https://solution.smarbiz.sbs/api/auth/saml/metadata/
SAML_SP_ACS_URL=https://solution.smarbiz.sbs/api/auth/saml/acs/
SAML_SP_SLS_URL=https://solution.smarbiz.sbs/api/auth/saml/logout/
SAML_SP_X509_CERT=
SAML_SP_PRIVATE_KEY=
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_SLO_URL=
SAML_IDP_X509_CERT=
SAML_EMAIL_ATTRIBUTE=email

# Native push notifications
# FIREBASE_CREDENTIALS_JSON accepts raw service-account JSON or its base64 encoding.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
# APNs requires a dedicated Push Notifications auth key. Do not reuse the
# Sign in with Apple or App Store Connect API private key.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=de.aplussolution.workforce
APNS_USE_SANDBOX=0

# Legal/company data used in PDFs
COMPANY_NAME=A+ Solution GmbH
COMPANY_ADDRESS=
AUEG_LICENSE_AUTHORITY=
AUEG_LICENSE_DATE=
COMPANY_BUSINESS_NUMBER=
LIBREOFFICE_BINARY=libreoffice

# Order text analysis (independent from When I Work)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_HTTP_TIMEOUT=30

# Legacy When I Work access: one-time final import/reconciliation only.
# A+ Workforce is the operational source of truth; recurring sync is disabled.
WIW_DEV_KEY=
WIW_EMAIL=
WIW_PASSWORD=
WIW_USER_ID=
WIW_WEBHOOK_SECRET=
WIW_HTTP_TIMEOUT=30
WIW_TOKEN_CACHE_SECONDS=3300
WIW_SYNC_ENABLED=0

# Backward-compatible aliases; new deployments should use OPENAI_* above.
WIW_OPENAI_KEY=
WIW_OPENAI_MODEL=gpt-4o-mini
WIW_DEFAULT_LOCATION_ID=

# External payroll/POS integrations do not store secrets in the database.
# Configure the HTTP header -> environment variable map from the integration UI/API,
# then add the referenced secret variables here or directly in production.
PAYROLL_API_TOKEN=
POS_API_TOKEN=

WORKING_TIME_DEFAULT_BREAK_MINUTES=0
WORKING_TIME_DEFAULT_MONTHLY_LIMIT=0
WORKING_TIME_DEFAULT_HOURLY_RATE=0
