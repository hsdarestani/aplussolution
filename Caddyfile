{$APP_DOMAIN:app.aplus-solution.de}, solution.smarbiz.sbs {
    @compressNonCalendar {
        not path /calendar/* /api/calendar/feed/* /calendar-compatibility-test.ics
    }
    encode @compressNonCalendar zstd gzip

    # The public calendar compatibility fixture must never fall through to SPA HTML.
    # Keep it on the same backend as the live calendar subscriptions.
    handle /calendar-compatibility-test.ics {
        reverse_proxy backend:8000
    }

    # Direct HTTPS calendar subscription URLs are separated from API routes.
    # Django still verifies each personal signed calendar token.
    handle /calendar/* {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    handle /health/ {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
        X-Aplus-Origin "strato-primary"
    }
}

staging.app.aplus-solution.de {
    encode zstd gzip

    reverse_proxy aplus_staging_edge:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
        X-Aplus-Gateway "staging"
    }
}

# Legacy domain is intentionally served by the same production origin.
